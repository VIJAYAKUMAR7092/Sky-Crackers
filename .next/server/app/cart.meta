{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(store)/layout,_N_T_/(store)/cart/layout,_N_T_/(store)/cart/page,_N_T_/cart,settings"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KHN0b3JlKQ",
    "/!KHN0b3JlKQ/cart/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 160,
                "slots": null
              }
            }
          }
        }
      }
    }
  }
}