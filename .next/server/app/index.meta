{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(store)/layout,_N_T_/(store)/page,_N_T_/,_N_T_/index,settings,products,categories"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KHN0b3JlKQ",
    "/!KHN0b3JlKQ/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 128,
            "slots": null
          }
        }
      }
    }
  }
}