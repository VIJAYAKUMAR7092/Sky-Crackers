# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# PostgreSQL Database URL
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/skycrackers?schema=public"

# NextAuth / Auth secrets
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-secret-and-put-it-here"

# WordPress Integration Placeholder
WORDPRESS_API_URL="https://skycrackers.in/wp-json"
WORDPRESS_CONSUMER_KEY="placeholder"
WORDPRESS_CONSUMER_SECRET="placeholder"

# Payment Credentials Placeholder
PAYMENT_GATEWAY_KEY="placeholder"
PAYMENT_GATEWAY_SECRET="placeholder"

# Email Configuration
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="placeholder"
EMAIL_PASS="placeholder"

# Admin Notifications
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
