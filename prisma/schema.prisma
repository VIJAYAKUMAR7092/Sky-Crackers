generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------
// Enums
// -------------------------------------
enum AdminRole {
  SUPERADMIN
  ADMIN
  MANAGER
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  COD
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum RecipientType {
  CUSTOMER
  ADMIN
}

// -------------------------------------
// Admin / Authentication
// -------------------------------------
model AdminUser {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String // Hashed password
  role      AdminRole @default(ADMIN)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// -------------------------------------
// Categories & Products
// -------------------------------------
model Category {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  image        String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  sku              String?     @unique
  shortDescription String?
  description      String?     @db.Text
  mrp              Decimal     @db.Decimal(10, 2)
  sellingPrice     Decimal     @db.Decimal(10, 2)
  discount         Decimal?    @db.Decimal(10, 2)
  packInfo         String?
  stockStatus      StockStatus @default(IN_STOCK)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  featured   Boolean @default(false)
  bestSeller Boolean @default(false)
  newArrival Boolean @default(false)
  active     Boolean @default(true)
  isCombo    Boolean @default(false)
  comboOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     ProductImage[]
  cartItems  CartItem[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([active])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
}

// -------------------------------------
// Customers & Addresses
// -------------------------------------
model Customer {
  id        String   @id @default(cuid())
  fullName  String
  email     String?  @unique
  phone     String   @unique
  altPhone  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  carts     Cart[]
  reviews   Review[]
}

model Address {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  locality     String?
  city         String
  district     String
  state        String
  pincode      String
  country      String  @default("India")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// -------------------------------------
// Cart
// -------------------------------------
model Cart {
  id         String    @id @default(cuid())
  sessionId  String?   @unique // For guest carts
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

// -------------------------------------
// Orders & Payments
// -------------------------------------
model Order {
  id             String @id @default(cuid())
  orderReference String @unique // Human-readable like SC-1001

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  couponId   String?
  couponCode String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  // Snapshots to preserve data even if customer/address is modified later
  customerSnapshot Json
  deliverySnapshot Json

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(10, 2)
  finalTotal     Decimal @db.Decimal(10, 2)
  currency       String  @default("INR")

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?

  isDeleted Boolean @default(false)
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  payments      Payment[]
  notifications Notification[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Keep relation to product but use SetNull to preserve order if product is deleted
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshots at time of purchase
  productName String
  sku         String?
  packInfo    String?

  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  mrp            Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status                PaymentStatus @default(PENDING)
  method                String?
  externalProvider      String?
  externalTransactionId String?       @unique
  gatewayResponse       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

// -------------------------------------
// Delivery Zones
// -------------------------------------
model DeliveryZone {
  id                    String   @id @default(cuid())
  name                  String
  state                 String?
  pincodes              String[]
  deliveryCharge        Decimal  @default(0) @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal? @db.Decimal(10, 2)
  estimatedTime         String?
  notes                 String?

  courier     String  @default("TRANSPORT")
  priority    Int     @default(2) // 1=High, 2=Medium, 3=Low
  deliverable Boolean @default(true)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------
// Coupons
// -------------------------------------
model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  description      String?
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(10, 2)
  minOrderValue    Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount      Decimal?     @db.Decimal(10, 2)
  usageLimit       Int?
  usedCount        Int          @default(0)
  perCustomerLimit Int?

  startDate  DateTime?
  expiryDate DateTime?
  active     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

// -------------------------------------
// Reviews
// -------------------------------------
model Review {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating        Int
  reviewText    String? @db.Text
  isApproved    Boolean @default(false)
  isFeatured    Boolean @default(false)
  isTestimonial Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([customerId])
}

// -------------------------------------
// Homepage / CMS
// -------------------------------------
model HomepageSection {
  id           String  @id @default(cuid())
  type         String
  title        String?
  content      Json?
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

// -------------------------------------
// Notifications
// -------------------------------------
model Notification {
  id            String        @id @default(cuid())
  recipientType RecipientType
  recipientId   String?

  type    String
  title   String
  message String @db.Text

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([recipientId])
  @@index([orderId])
}

// -------------------------------------
// Phase 9 CMS Extensions
// -------------------------------------
model WebsiteSettings {
  id           String  @id @default("global")
  siteName     String  @default("Sky Crackers")
  logoUrl      String?
  primaryPhone String?
  whatsapp     String?
  email        String?
  address      String? @db.Text
  facebook     String?
  instagram    String?
  youtube      String?
  twitter      String?
  footerText   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroBanner {
  id           String  @id @default(cuid())
  image        String
  title        String?
  subtitle     String?
  buttonText   String?
  buttonLink   String?
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoContent {
  id           String  @id @default(cuid())
  youtubeUrl   String
  title        String?
  thumbnail    String?
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaticPage {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  content String  @db.Text
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SEOSettings {
  id          String  @id @default(cuid())
  path        String  @unique @default("/")
  title       String?
  description String? @db.Text
  keywords    String? @db.Text
  ogImage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
